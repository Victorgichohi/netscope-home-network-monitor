HNM_APP_NAME=Home Network Monitor
HNM_ENVIRONMENT=production
HNM_SECRET_KEY=replace-with-at-least-32-random-characters
HNM_ADMIN_USERNAME=admin
HNM_ADMIN_PASSWORD=replace-with-a-long-unique-password
HNM_DATABASE_URL=sqlite:///./home_net_monitor.db
HNM_SESSION_HTTPS_ONLY=false

# Discovery and capture. Leave subnet/interface blank for automatic detection.
HNM_NETWORK_INTERFACE=
HNM_SUBNET=
HNM_DISCOVERY_INTERVAL_SECONDS=300
HNM_DEVICE_OFFLINE_AFTER_SECONDS=600
HNM_DISCOVERY_ENABLED=true
HNM_TRAFFIC_CAPTURE_ENABLED=false
HNM_CAPTURE_BPF_FILTER=ip or ip6
HNM_TRAFFIC_RETENTION_DAYS=30
HNM_DNS_RETENTION_DAYS=7
HNM_DIAGNOSTICS_ENABLED=true
HNM_DIAGNOSTICS_INTERVAL_SECONDS=300
HNM_DIAGNOSTIC_HOSTNAME=example.com

# auto/computer reports capture as this-device-only. Use gateway or mirror only
# when the collector truly runs at that network vantage point.
HNM_VISIBILITY_MODE=auto

# Bounded Cloudflare speed samples. Scheduled tests are off by default because
# each run transfers roughly the configured download + upload byte counts.
HNM_SPEEDTEST_ENABLED=true
HNM_SPEEDTEST_SCHEDULED=false
HNM_SPEEDTEST_INTERVAL_SECONDS=21600
HNM_SPEEDTEST_DOWNLOAD_BYTES=10000000
HNM_SPEEDTEST_UPLOAD_BYTES=2000000

# Router control is disabled until explicitly configured.
# Supported adapters: disabled, ssh, http, huawei_ont
HNM_ROUTER_ADAPTER=disabled
HNM_ROUTER_HOST=192.168.1.1
HNM_ROUTER_PORT=22
HNM_ROUTER_USERNAME=
HNM_ROUTER_PASSWORD=
HNM_ROUTER_SSH_KEY_PATH=
HNM_ROUTER_STATUS_COMMAND=uptime
HNM_ROUTER_REBOOT_COMMAND=sudo /sbin/reboot
HNM_ROUTER_HTTP_STATUS_URL=
HNM_ROUTER_HTTP_REBOOT_URL=
HNM_ROUTER_HTTP_BEARER_TOKEN=
HNM_ROUTER_VERIFY_TLS=true

# Huawei ONT health (huawei_ont adapter only). Uses HNM_ROUTER_HOST,
# HNM_ROUTER_USERNAME and HNM_ROUTER_PASSWORD. The ONT allows one admin web
# session, so each poll signs out anyone using the router page in a browser.
HNM_ROUTER_HEALTH_ENABLED=true
HNM_ROUTER_HEALTH_INTERVAL_SECONDS=900
HNM_ROUTER_HEALTH_RETENTION_DAYS=90
# Two-letter country code the Wi-Fi radio should be set to, e.g. KE.
HNM_ROUTER_EXPECTED_COUNTRY=
